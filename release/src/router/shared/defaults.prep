static inline int dualwan_unit__usbif(int unit)
{
 int type = get_dualwan_by_unit(unit);
 return (type == 4



   );
}

static inline int dualwan_unit__nonusbif(int unit)
{
 int type = get_dualwan_by_unit(unit);
 return (type == 2 || type == 1 || type == 3 || type == 7

  || type == WAN_UNIT_IPTV || type == WAN_UNIT_VOIP

   );
