 }



 if ((strncmp(name, "wl", 2) == 0) && (((__ctype_b))[(int) ((name[2]))] & (__ctype_mask_t) _ISdigit) && (name[3] == '_'))
 for (idx = 0; router_defaults[idx].name != ((void *)0); idx++) {
  if (strcmp(router_defaults[idx].name, name) == 0) {
